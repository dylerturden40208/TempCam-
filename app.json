{
  "expo": {
    "name": "TempCam!",
    "slug": "TempCam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tempcam",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.TempCam",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TempCam! to access your camera to take temporary photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow TempCam! to save temporary photos.",
          "savePhotosPermission": "Allow TempCam! to save temporary photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}